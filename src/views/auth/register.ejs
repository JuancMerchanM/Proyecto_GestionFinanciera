<section class="auth">
  <div class="card auth__card">
    <h1>Crear cuenta</h1>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash--error" role="alert"><%= error %></div>
    <% } %>
    <form method="POST" action="/register" data-validate="register" novalidate>
      <div class="form-group">
        <label for="name">Nombre</label>
        <input class="form-control" type="text" id="name" name="name" required minlength="2" maxlength="80"
               value="<%= form.name %>" autocomplete="name" placeholder="Ana Pérez">
        <p class="field-error" hidden></p>
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required
               value="<%= form.email %>" autocomplete="email" placeholder="ana@ejemplo.com">
        <p class="field-error" hidden></p>
      </div>
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input class="form-control" type="password" id="password" name="password" required minlength="8" maxlength="72"
               autocomplete="new-password" placeholder="Mínimo 8 caracteres">
        <p class="form-hint">Mínimo 8 caracteres.</p>
        <p class="field-error" hidden></p>
      </div>
      <div class="form-group">
        <label for="password2">Confirmar contraseña</label>
        <input class="form-control" type="password" id="password2" name="password2" required minlength="8" maxlength="72"
               autocomplete="new-password" data-match="password">
        <p class="field-error" hidden></p>
      </div>
      <button class="btn btn--primary btn--block" type="submit">Crear cuenta</button>
    </form>
    <p class="auth__alt">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </div>
</section>
