<section class="auth">
  <div class="card auth__card">
    <h1>Iniciar sesión</h1>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash--error" role="alert"><%= error %></div>
    <% } %>
    <form method="POST" action="/login" data-validate="login" novalidate>
      <input type="hidden" name="next" value="<%= typeof next !== 'undefined' && next ? next : '/' %>">
      <div class="form-group">
        <label for="email">Email</label>
        <input class="form-control" type="email" id="email" name="email" required
               value="<%= form.email %>" autocomplete="email" placeholder="ana@ejemplo.com">
        <p class="field-error" hidden></p>
      </div>
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input class="form-control" type="password" id="password" name="password" required
               autocomplete="current-password" placeholder="Tu contraseña">
        <p class="field-error" hidden></p>
      </div>
      <button class="btn btn--primary btn--block" type="submit">Entrar</button>
    </form>
    <p class="auth__alt">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
  </div>
</section>
