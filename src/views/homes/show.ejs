<section class="page-head">
  <h1><%= home.name %></h1>
  <div class="page-head__actions">
    <a class="btn btn--primary" href="/homes/<%= home.id %>/dashboard">Dashboard</a>
    <a class="btn btn--ghost" href="/homes/<%= home.id %>/transactions">Movimientos</a>
    <a class="btn btn--ghost" href="/homes/<%= home.id %>/budgets">Presupuestos</a>
    <a class="btn btn--ghost" href="/homes/<%= home.id %>/accounts">Cuentas</a>
    <a class="btn btn--ghost" href="/homes/<%= home.id %>/categories">Categorías</a>
    <% if (home.role === 'admin') { %>
      <a class="btn btn--ghost" href="/homes/<%= home.id %>/edit">Editar</a>
    <% } %>
    <span class="badge"><%= home.currency %></span>
    <span class="badge badge--role"><%= home.role %></span>
    <form method="POST" action="/homes/<%= home.id %>/leave" class="nav__form"
          data-confirm="¿Seguro que quieres salir del hogar «<%= home.name %>»?">
      <button class="btn btn--ghost" type="submit">Salir del hogar</button>
    </form>
  </div>
</section>

<div class="card">
  <h2>Miembros <span class="muted">(<%= members.length %>)</span></h2>
  <ul class="member-list">
    <% members.forEach(m => { %>
      <li class="member-list__item">
        <span class="avatar"><%= m.name.charAt(0).toUpperCase() %></span>
        <span class="member-list__name">
          <%= m.name %>
          <% if (m.userId === currentUser.id) { %><span class="muted">(tú)</span><% } %>
        </span>
        <span class="muted member-list__email"><%= m.email %></span>
        <span class="badge <%= m.role === 'admin' ? 'badge--admin' : '' %>"><%= m.role %></span>
        <% if (home.role === 'admin' && m.userId !== currentUser.id) { %>
          <span class="member-list__actions">
            <form method="POST" action="/homes/<%= home.id %>/members/<%= m.userId %>" class="role-form">
              <label class="visually-hidden" for="role-<%= m.userId %>">Rol de <%= m.name %></label>
              <select class="form-control form-control--sm" id="role-<%= m.userId %>" name="role">
                <option value="admin" <%= m.role === 'admin' ? 'selected' : '' %>>admin</option>
                <option value="member" <%= m.role === 'member' ? 'selected' : '' %>>member</option>
              </select>
              <button class="btn btn--ghost btn--sm" type="submit">Guardar rol</button>
            </form>
            <form method="POST" action="/homes/<%= home.id %>/members/<%= m.userId %>/delete"
                  data-confirm="¿Quitar a <%= m.name %> del hogar? Sus movimientos se conservarán.">
              <button class="btn btn--danger btn--sm" type="submit">Quitar</button>
            </form>
          </span>
        <% } %>
      </li>
    <% }) %>
  </ul>
</div>

<% if (home.role === 'admin') { %>
  <div class="card">
    <h2>Invitaciones</h2>
    <p class="muted">Genera un código y compártelo manualmente (link o texto) con la persona a invitar.</p>

    <form method="POST" action="/homes/<%= home.id %>/invites" class="invite-form">
      <div class="form-row">
        <label>
          Rol
          <select class="form-control" name="role">
            <option value="member">member</option>
            <option value="admin">admin</option>
          </select>
        </label>
        <label>
          Email destino (opcional)
          <input class="form-control" type="email" name="email" placeholder="solo ese email puede aceptar">
        </label>
      </div>
      <button class="btn btn--primary" type="submit">Generar código</button>
    </form>

    <% if (invites.length > 0) { %>
      <h3>Pendientes</h3>
      <ul class="invite-list">
        <% invites.forEach(inv => { %>
          <li class="invite-list__item">
            <code class="code"><%= inv.code %></code>
            <span class="muted">→ <%= inviteUrl(inv.code) %> · rol <%= inv.role %><%= inv.email ? ' · ' + inv.email : '' %> · vence <%= new Date(inv.expiresAt).toLocaleDateString('es-CO') %></span>
            <form method="POST" action="/homes/<%= home.id %>/invites/<%= inv.code %>/revoke"
                  data-confirm="¿Revocar la invitación <%= inv.code %>? Dejará de poder usarse.">
              <button class="btn btn--danger btn--sm" type="submit">Revocar</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="card card--danger">
    <h2>Zona de peligro</h2>
    <p class="muted">Elimina el hogar y <strong>todos sus datos</strong> (movimientos, cuentas,
      categorías, presupuestos e invitaciones). Esta acción es irreversible.</p>
    <form method="POST" action="/homes/<%= home.id %>/delete" class="danger-form"
          data-confirm="¿Eliminar definitivamente el hogar «<%= home.name %>»? Se borrarán todos sus datos.">
      <label class="checkbox">
        <input type="checkbox" name="confirm" value="1" required>
        Entiendo que esta acción es irreversible
      </label>
      <button class="btn btn--danger" type="submit">Eliminar hogar</button>
    </form>
  </div>
<% } %>
