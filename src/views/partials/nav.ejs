<header class="topbar">
  <div class="container topbar__inner">
    <a class="brand" href="/">💰 Finanzas del Hogar</a>
    <nav class="nav" aria-label="Principal">
      <% if (currentUser) { %>
        <span class="nav__user"><%= currentUser.name %></span>
        <% if (homes && homes.length > 0) { %>
          <details class="nav__dropdown" id="home-switcher">
            <summary class="nav__link nav__dropdown-toggle" aria-label="Cambiar de hogar">
              <%= currentHome ? currentHome.name : 'Hogares' %> ▾
            </summary>
            <div class="dropdown__menu" role="menu">
              <% homes.forEach(h => { %>
                <a class="dropdown__item<%= h.id === currentHomeId ? ' is-active' : '' %>"
                   role="menuitem" href="/homes/<%= h.id %>"><%= h.name %></a>
              <% }) %>
              <hr class="dropdown__divider">
              <a class="dropdown__item" role="menuitem" href="/homes">Mis hogares</a>
              <a class="dropdown__item" role="menuitem" href="/homes/new">Crear hogar</a>
            </div>
          </details>
        <% } else if (currentHomeId) { %>
          <a href="/homes/<%= currentHomeId %>" class="nav__link">Mi hogar</a>
        <% } else { %>
          <a href="/homes" class="nav__link">Mis hogares</a>
        <% } %>
        <form method="POST" action="/logout" class="nav__form">
          <button class="nav__link nav__button" type="submit">Cerrar sesión</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav__link">Iniciar sesión</a>
        <a href="/register" class="nav__link nav__link--accent">Registrarse</a>
      <% } %>
      <a href="/api-docs" class="nav__link">API</a>
    </nav>
  </div>
</header>
