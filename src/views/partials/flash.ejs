<% if (typeof flash !== 'undefined' && flash && (flash.success || flash.error)) { %>
  <% if (flash.success) { %>
    <div class="flash flash--success" role="status"><%= flash.success %></div>
  <% } %>
  <% if (flash.error) { %>
    <div class="flash flash--error" role="alert"><%= flash.error %></div>
  <% } %>
<% } %>
