<section class="page-head">
  <h1><%= home.name %> · Categorías</h1>
  <div class="page-head__actions">
    <a class="btn btn--ghost" href="/homes/<%= home.id %>">Volver al hogar</a>
    <% if (role === 'admin') { %>
      <a class="btn btn--primary" href="/homes/<%= home.id %>/categories/new">Nueva categoría</a>
    <% } %>
  </div>
</section>

<div class="filters">
  <a class="chip <%= !includeArchived ? 'chip--active' : '' %>" href="/homes/<%= home.id %>/categories">Activas</a>
  <a class="chip <%= includeArchived ? 'chip--active' : '' %>" href="/homes/<%= home.id %>/categories?archived=1">Archivadas</a>
</div>

<% if (categories.length === 0) { %>
  <div class="card"><p class="muted">No hay categorías en esta vista.</p></div>
<% } else { %>
  <div class="grid">
    <% categories.forEach(c => { %>
      <div class="card cat-card <%= c.archived ? 'cat-card--archived' : '' %>">
        <span class="cat-card__swatch" style="background:<%= c.color %>"></span>
        <div class="cat-card__body">
          <span class="cat-card__name"><%= c.name %></span>
          <span class="badge <%= c.type === 'income' ? 'badge--income' : 'badge--expense' %>">
            <%= c.type === 'income' ? 'ingreso' : 'gasto' %>
          </span>
          <% if (c.isDefault) { %><span class="muted">semilla</span><% } %>
          <% if (c.archived) { %><span class="badge">archivada</span><% } %>
        </div>
        <% if (role === 'admin') { %>
          <div class="cat-card__actions">
            <% if (c.archived) { %>
              <form method="POST" action="/homes/<%= home.id %>/categories/<%= c.id %>/restore">
                <button class="btn btn--ghost btn--sm" type="submit">Restaurar</button>
              </form>
            <% } else { %>
              <a class="btn btn--ghost btn--sm" href="/homes/<%= home.id %>/categories/<%= c.id %>/edit">Editar</a>
              <form method="POST" action="/homes/<%= home.id %>/categories/<%= c.id %>/delete" data-confirm="¿Eliminar «<%= c.name %>»? Si tiene transacciones se archivará.">
                <button class="btn btn--danger btn--sm" type="submit">Eliminar</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } %>
