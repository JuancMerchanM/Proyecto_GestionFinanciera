<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Registro de ingresos, gastos y presupuestos del hogar">
  <title><%= typeof title !== 'undefined' && title ? title + ' · ' : '' %>Finanzas del Hogar</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <footer class="footer container">
    <small>Finanzas del Hogar · <% if (typeof year !== 'undefined' && year) { %><%= year %><% } else { %><%= new Date().getFullYear() %><% } %></small>
  </footer>
  <script src="/js/app.js" defer></script>
  <% if (typeof scripts !== 'undefined' && scripts && scripts.length) { %>
    <% scripts.forEach(function (src) { %><script src="<%= src %>" defer></script><% }) %>
  <% } %>
</body>
</html>
